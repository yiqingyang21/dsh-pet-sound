// ============================================================================
// 大肥鱼 · 声音系统配置
// 路径：~/.dsh/dsh-pet/sound.jsonc（改完重启宠物窗口生效：右键宠物 →「重载配置」）
// 说明：所有字段都可省略，省略即用内置默认；写错类型不会崩，会回落到默认值。
// ============================================================================
{
  // 声音总开关（false = 全静音，但音效/语音各自的设置保留）
  "enabled": true,

  // 总音量 0 ~ 1
  "volume": 0.8,

  // ---------------- 音效：点击 / 拖拽 / 落地 / 气泡 … ----------------
  "sfx": {
    "enabled": true,
    "volume": 1,

    // 逐项开关：哪一项听着烦就把哪一项关掉
    "click": true,      // 点一下宠物（开心/害羞/傲娇回应时）
    "dragStart": true,  // 开始拖拽
    "drop": true,       // 松手落地
    "throw": true,      // 被甩出去飞行时
    "bubble": true,     // 气泡弹出
    "whisper": true,    // 碎碎念出现
    "balance": true,    // 余额 / 金币
    "error": true,      // 配置或加载出错
  },

  // ---------------- 说话：把气泡里的文字念出来 ----------------
  "voice": {
    "enabled": true,

    // 发声方式：
    // auto    = OneCore(Yaoyao 甜妹) → SAPI(Huihui 播报腔) → Chromium → 电子音，逐级降级（推荐）
    // onecore = 只用 OneCore 常驻语音（最甜，默认 Yaoyao）
    // sapi    = 只用系统 SAPI（Huihui，成熟播报腔）
    // tts     = 只用 Chromium 的 speechSynthesis（本机看不到语音，会没声，仅排障）
    // blip    = 只用宠物电子音（按字"嘟嘟"，念不出字义，但零依赖）
    "mode": "auto",

    // OneCore 语音名（模糊匹配）：
    //   Yaoyao   —— 年轻女声，偏甜（默认）
    //   Huihui   —— 成熟女声，播音腔
    //   Kangkang —— 男声
    "onecoreVoice": "Yaoyao",

    // 语速 0.5 ~ 2；音调 0.5 ~ 2.5（系统语音与电子音共用）
    "rate": 1,
    "pitch": 1.15,

    // 语言：影响挑哪个系统语音
    "lang": "zh-CN",

    // 单句最多念多少个字（超长回复只念开头，避免念一分钟）
    "maxChars": 120,

    // 音量
    "volume": 0.9,

    // 哪些内容要念：气泡文字 / 余额播报 / 点击
    // 注意：碎碎念、对话回复、第三方广播在宿主里共用同一个 say 叶子，运行时区分不出来，
    //       所以它们合成一个开关 speakBubble（false = 所有气泡都不念）。
    "speakBubble": true,
    "speakBalance": false,
    "speakClick": false,
  },

  // 调试日志：true 会把每次发声、TTS 探测结果打到控制台（排障用）
  "log": false,
}
